<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
      SPRING_ENDPOINT flags every @RequestMapping method for review, and SecurityConfig already
      guards each one.
    -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!--
      SERVLET_HEADER fires on every header read, and JWT auth reads Authorization on every request.
    -->
    <Match>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>

    <!--
      THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION on test classes only. MockMvc.perform()
      itself declares 'throws Exception', so rewrapping in the test adds nothing when the
      test fails fast on any throw anyway.
    -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
        <Class name="~.*Test(\$.+)?"/>
    </Match>

    <!--
      EI_EXPOSE_REP2 on Spring beans holding injected singletons (WebClient, repositories, mappers)
      that are never mutated after construction.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="com.betterreads.mailoutbox.MailOutboxService"/>
            <Class name="com.betterreads.features.account.PasswordResetService"/>
            <Class name="com.betterreads.features.account.EmailVerificationService"/>
            <Class name="com.betterreads.features.account.AccountDeletionSweep"/>
            <Class name="com.betterreads.ratelimit.RateLimitFilter"/>
            <Class name="com.betterreads.features.search.SearchHitListener"/>
            <Class name="com.betterreads.features.bookdetail.BookDetailController"/>
            <Class name="com.betterreads.book.BookUpsertServiceImpl"/>
            <Class name="com.betterreads.features.shelves.ShelfController"/>
            <Class name="com.betterreads.features.shelves.ShelfServiceImpl"/>
            <Class name="com.betterreads.features.shelves.ShelfWriter"/>
            <Class name="com.betterreads.ratelimit.DistributedRateLimiter"/>
            <Class name="com.betterreads.clients.itunes.ItunesApi"/>
            <Class name="com.betterreads.clients.wikipedia.WikipediaApi"/>
            <Class name="com.betterreads.clients.minio.MinioImageStore"/>
            <Class name="com.betterreads.clients.coverfetch.CoverFetchClient"/>
            <Class name="com.betterreads.features.coverimages.CoverMirrorService"/>
            <Class name="com.betterreads.features.coverimages.CoverImageService"/>
            <Class name="com.betterreads.features.reviews.ReviewServiceImpl"/>
            <Class name="com.betterreads.features.reviews.ReviewWriter"/>
            <Class name="com.betterreads.features.reviews.ReaderRatingsImpl"/>
            <Class name="com.betterreads.features.reviews.ReviewLookupImpl"/>
            <Class name="com.betterreads.features.reviews.ReviewController"/>
            <Class name="com.betterreads.features.comments.CommentServiceImpl"/>
            <Class name="com.betterreads.features.comments.CommentController"/>
            <Class name="com.betterreads.features.comments.CommentResponseAssembler"/>
            <Class name="com.betterreads.clients.googlebooks.GoogleBooksClientImpl"/>
            <Class name="com.betterreads.clients.hardcoverauthor.HardcoverAuthorClientImpl"/>
            <Class name="com.betterreads.clients.hardcoverbook.HardcoverClientImpl"/>
            <Class name="com.betterreads.clients.hardcoverseries.HardcoverSeriesClientImpl"/>
            <Class name="com.betterreads.clients.openlibrary.OpenLibraryClientImpl"/>
            <Class name="com.betterreads.clients.loc.LocSru"/>
            <Class name="com.betterreads.clients.wikidata.WikidataApi"/>
            <Class name="com.betterreads.bookindex.AuthorIndexViewReader"/>
        </Or>
    </Match>

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2 on JPA entities and the credit record that carries them.
      Hibernate tracks the live collection instance for dirty-checking and cascade. Returning or
      accepting a defensive copy would break orphan removal and managed-collection semantics.
      Entities are not value objects.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Or>
            <Class name="com.betterreads.book.Book"/>
            <Class name="com.betterreads.book.BookAward"/>
            <Class name="com.betterreads.book.BookSubject"/>
            <Class name="com.betterreads.book.BookAuthor"/>
            <Class name="com.betterreads.book.ResolvedCredit"/>
        </Or>
    </Match>

    <!--
      NP_UNWRITTEN_FIELD / UWF_UNWRITTEN_FIELD on @Autowired test fields. Spring sets these
      reflectively, which SpotBugs cannot see, so it reads them as never written. Scoped to
      test classes only.
    -->
    <Match>
        <Bug pattern="NP_UNWRITTEN_FIELD,UWF_UNWRITTEN_FIELD"/>
        <Class name="~.*Test(\$.+)?"/>
    </Match>

    <!--
      UWF_UNWRITTEN_FIELD on the book_author id class. Hibernate writes the id fields reflectively.
    -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
        <Class name="com.betterreads.book.BookAuthorId"/>
    </Match>

    <!--
      CRLF_INJECTION_LOGS on the opt-in verification suites. FindSecBugs misses LogSanitizer.forLog
      behind the static import, and the title is sanitized.
    -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Or>
            <Class name="com.betterreads.book.CatalogOpenLibrarySeedVerification"/>
            <Class name="com.betterreads.features.bookstaging.CatalogPipelineLiveE2eTest"/>
            <Class name="com.betterreads.features.bookstaging.CatalogPipelineLocalDbVerification"/>
            <Class name="com.betterreads.features.descriptionbackfill.DescriptionBackfillLocalDbVerification"/>
        </Or>
    </Match>

    <!--
      CRLF_INJECTION_LOGS on the catalog source fan-out. These warn lines log a BookFieldSource enum
      constant and an exception class name, never an external string. FindSecBugs taints the whole
      log call because the surrounding objects came from an HTTP response, but neither logged value
      can carry CRLF.
    -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Or>
            <Class name="com.betterreads.features.bookstaging.SourceCollector"/>
            <Class name="com.betterreads.features.bookstaging.BookStager"/>
            <Class name="com.betterreads.bookdescription.DescriptionSelector"/>
        </Or>
    </Match>

    <!--
      CRLF_INJECTION_LOGS on ConflictRetry. The shelf and review services pass an event string built
      from two Long ids, so it cannot carry CRLF.
    -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Class name="com.betterreads.db.ConflictRetry"/>
    </Match>

    <!--
      IMPROPER_UNICODE on TextMatch. It compares a book title with a search query, so a Unicode
      case-folding collision only skews a match.
    -->
    <Match>
        <Bug pattern="IMPROPER_UNICODE"/>
        <Class name="com.betterreads.text.TextMatch"/>
    </Match>

    <!--
      IMPROPER_UNICODE on StoredNames. Case folding and NFC normalization are the point: a confirmed
      name only reuses a stored spelling, and a key two stored names share is dropped.
    -->
    <Match>
        <Bug pattern="IMPROPER_UNICODE"/>
        <Class name="com.betterreads.features.metadatacheck.StoredNames"/>
    </Match>

    <!--
      IMPROPER_UNICODE on the metadata check. PageText folds case and compatibility forms so a quote
      matches the page it was copied from, and the mapper matches a lower-case status word against a
      fixed enum. Neither is an identity or security check.
    -->
    <Match>
        <Bug pattern="IMPROPER_UNICODE"/>
        <Or>
            <Class name="com.betterreads.clients.websearch.PageText$Folded"/>
            <Class name="com.betterreads.clients.websearch.MetadataCheckMapper"/>
        </Or>
    </Match>

    <!--
      CRLF_INJECTION_LOGS on the metadata check run log. The lines log enum constants, counts and
      LogSanitizer.forLog output, so no logged value can carry CRLF.
    -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Or>
            <Class name="com.betterreads.features.metadatacheck.MetadataCheckService"/>
            <Class name="com.betterreads.features.metadatacheck.MetadataCheckService$Summary"/>
        </Or>
    </Match>

    <!--
      IMPROPER_UNICODE on the language-code lookup. The input is a source's ISO 639 code, lower-cased
      to look up a fixed ASCII table.
    -->
    <Match>
        <Bug pattern="IMPROPER_UNICODE"/>
        <Class name="com.betterreads.bookmerge.LanguageCodes"/>
    </Match>

    <!--
      IMPROPER_UNICODE on title and name casing. Case changes only build display text or a
      comparison key, never an identity or security check.
    -->
    <Match>
        <Bug pattern="IMPROPER_UNICODE"/>
        <Or>
            <Class name="com.betterreads.bookmerge.TitleCasing"/>
            <Class name="com.betterreads.booksource.IssueRunSeries"/>
            <Class name="com.betterreads.text.AuthorNames"/>
        </Or>
    </Match>

    <!--
      REDOS on the description patterns. Every quantifier is possessive, which FindSecBugs does not model.
    -->
    <Match>
        <Bug pattern="REDOS"/>
        <Or>
            <Class name="com.betterreads.bookdescription.DescriptionCleaner"/>
            <Class name="com.betterreads.bookdescription.DescriptionQuality"/>
        </Or>
    </Match>

    <!--
      COMMAND_INJECTION and CRLF_INJECTION_LOGS on WebSearchRunner. The argv comes from the web-search
      config and a fixed schema, the prompt goes over stdin, and the log lines carry exception class
      names, numbers, and a sanitized subtype.
    -->
    <Match>
        <Bug pattern="COMMAND_INJECTION,CRLF_INJECTION_LOGS"/>
        <Class name="com.betterreads.clients.websearch.WebSearchRunner"/>
    </Match>
</FindBugsFilter>
